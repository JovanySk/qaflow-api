# Local profile only. Copy values into your shell or a local ignored .env loader.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=3306
DB_NAME=qaflow
DB_USERNAME=qaflow
DB_PASSWORD=replace_with_local_password

# Generate at least 32 random bytes and Base64-encode them. Never commit the real value.
JWT_SECRET_BASE64=replace_with_base64_secret_of_at_least_32_bytes
JWT_ISSUER=qaflow-backend
JWT_AUDIENCE=qaflow-web
JWT_EXPIRATION_SECONDS=900

# Optional demo-only bootstrap. Keep disabled outside disposable local/demo databases.
QAFLOW_BOOTSTRAP_ENABLED=false
QAFLOW_ADMIN_USERNAME=admin.demo
QAFLOW_ADMIN_DISPLAY_NAME=Demo Administrator
QAFLOW_ADMIN_PASSWORD=replace_with_demo_password
QAFLOW_OPERATOR_USERNAME=operator.demo
QAFLOW_OPERATOR_DISPLAY_NAME=Demo Operator
QAFLOW_OPERATOR_PASSWORD=replace_with_demo_password
QAFLOW_INSPECTOR_USERNAME=inspector.demo
QAFLOW_INSPECTOR_DISPLAY_NAME=Demo Quality Inspector
QAFLOW_INSPECTOR_PASSWORD=replace_with_demo_password

# Production profile additionally requires a complete TLS-enabled JDBC URL.
DB_URL=jdbc:mysql://database-host:3306/qaflow?sslMode=VERIFY_IDENTITY&connectionTimeZone=UTC
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=2

SWAGGER_ENABLED=true
